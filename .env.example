# Àkànjí Oníṣòwò — Environment configuration
# Copy to .env and fill in your values

# === OKX Agentic Wallet ===
# Which wallet to use as the trading account
OKX_WALLET_ADDRESS=0xce34cff4e4d54cfb8b1b5496ba9ff7a28c4ace2a
OKX_AGENT_ID=
OKX_ACCOUNT_EMAIL=adazycommunicator@gmail.com

# === Email (Resend) ===
# Get a free API key at https://resend.com
RESEND_API_KEY=
EMAIL_FROM=akanji@resend.dev
EMAIL_TO=pazzycamero@gmail.com

# === Trading parameters (300 USDT mode) ===
TRADING_CAPITAL_USDT=300
TRADING_MODE=paper  # paper | live
MAX_POSITION_SIZE_PCT=0.20
MAX_POSITION_SIZE_USDT=60
MIN_POSITION_SIZE_USDT=30
MAX_CONCURRENT_POSITIONS=2
MAX_TOTAL_EXPOSURE_PCT=0.60
CASH_RESERVE_PCT=0.40

# === Stop / take-profit rules ===
STOP_LOSS_PCT=0.05
TAKE_PROFIT_1_PCT=0.10
TAKE_PROFIT_2_PCT=0.20
TRAILING_STOP_ACTIVATION_PCT=0.15
TRAILING_STOP_DISTANCE_PCT=0.01
TIME_STOP_HOURS=4
MAX_FEE_AS_PCT_OF_EXPECTED_GAIN=0.30

# === Daily / total limits ===
DAILY_LOSS_LIMIT_PCT=0.08
KILL_SWITCH_PCT=0.20

# === Network ===
CHAIN_ID=196
CHAIN_NAME=xlayer
CHAIN_RPC=https://rpc.xlayer.tech
USDT_TOKEN_ADDRESS=0x779ded0c9e1022225f8e0630b35a9b54be713736

# === Runtime ===
LOG_LEVEL=info
TICK_INTERVAL_SECONDS=30
NODE_ENV=production
